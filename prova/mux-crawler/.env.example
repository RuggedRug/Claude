# Okta Credentials (for manual login flow)
# Leave empty if using manual-only authentication
OKTA_USERNAME=
OKTA_PASSWORD=

# Manual Verification Timeout (5 minutes in milliseconds)
MANUAL_VERIFICATION_WAIT=300000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=analytics

# PostgreSQL connection string (alternative to individual params)
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/analytics

# Mux Dashboard Configuration
MUX_ORG_ID=your_org_id
MUX_ENV_ID=your_env_id
MUX_USER_ID=your_user_id

# Extraction Configuration
EXTRACTION_START_DATE=2024-10-01
CONCURRENCY_LIMIT=3
